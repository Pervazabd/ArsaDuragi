# ArsaDuragi API test dəsti (Visual Studio .http faylı)
#
# NECƏ İSTİFADƏ OLUNUR
#  1. ArsaDuragi.API işləyir olmalıdır (F5). Aşağıdakı @host portu launchSettings ilə uyğun olmalıdır.
#  2. Sorğunu göndərmək üçün "###" ilə başlayan blokun üstündəki "Send request" düyməsinə basın.
#  3. SIRASI İLƏ gedin (yuxarıdan aşağı). Sonrakı sorğular əvvəlkilərin cavabından token/id götürür.
#  4. Hər sorğunun üstündəki "# EXPECT:" sətri gözlənilən nəticədir.
#  5. Faylı təkrar işlətmək üçün @run dəyərini artırın (e-poçtlar və şəhər adı təkrar olmasın).
#
# ƏVVƏLCƏDƏN: auth rate-limit dəqiqədə 10 sorğudur. Test zamanı bloklanmamaq üçün:
#   dotnet user-secrets set "RateLimiting:AuthPermitLimit" "1000" --project ArsaDuragi.API   (sonra API-ni yenidən başladın)
# Admin hesabı: Seed:AdminEmail / Seed:AdminPassword (user-secrets). Aşağıdakı dəyərləri öz secret-lərinizə görə dəyişin.

@baseUrl = http://localhost:5080
@run = 1
@adminEmail = admin@arsaduragi.local
@adminPassword = Admin12345
@pwd = Passw0rd1
@email1 = musteri1-{{run}}@test.az
@email2 = musteri2-{{run}}@test.az
@email3 = musteri3-{{run}}@test.az

@adminToken = {{adminLogin.response.body.$.data.accessToken}}
@adminId = {{adminLogin.response.body.$.data.userId}}
@customerToken = {{reg1.response.body.$.data.accessToken}}
@customer3Token = {{reg3.response.body.$.data.accessToken}}
@cityId = {{cities.response.body.$.data[0].id}}
@districtId = {{districts.response.body.$.data[0].id}}
@adId = {{createAd.response.body.$.data.id}}
@adSlug = {{createAd.response.body.$.data.slug}}
@adId2 = {{createAd2.response.body.$.data.id}}
@img1 = {{upload2.response.body.$.data[0].id}}
@img2 = {{upload2.response.body.$.data[1].id}}
@demoId = {{demoGet.response.body.$.data.id}}
@testCityId = {{createCity.response.body.$.data.id}}
@testDistrictId = {{createDistrict.response.body.$.data.id}}
@user3Id = {{usersSearch.response.body.$.data.items[0].id}}
@pendId = {{pendAd.response.body.$.data.id}}
@pendSlug = {{pendAd.response.body.$.data.slug}}


########################################################################
# 0. Mühit
# Baza təzə olmalıdır (9 demo elan). Gözlənilən saylar buna əsaslanır.

### 0.1  Swagger sənədi yaranır
# EXPECT: 200
GET http://localhost:5080/swagger/v1/swagger.json

### 0.2  Demo elanlar seed olunub
# EXPECT: 200; data.totalCount = 9
# @name list0
GET {{baseUrl}}/api/properties

########################################################################
# 1. Autentifikasiya

### 1.1  Müştəri 1 qeydiyyatı
# EXPECT: 201; roles=["User"]; accessToken və refreshToken var
# @name reg1
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Müştəri Bir",
  "email": "{{email1}}",
  "phoneNumber": "+994501234567",
  "password": "{{pwd}}",
  "confirmPassword": "{{pwd}}"
}

### 1.2  Eyni e-poçt təkrar qeydiyyat
# EXPECT: 409
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "T\u0259krar",
  "email": "{{email1}}",
  "password": "{{pwd}}",
  "confirmPassword": "{{pwd}}"
}

### 1.3  Zəif şifrə + uyğun gəlməyən təsdiq
# EXPECT: 400; success=false; errors boş deyil
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "X",
  "email": "zeif-{{run}}@test.az",
  "password": "abc",
  "confirmPassword": "xyz"
}

### 1.4  Yanlış e-poçt formatı
# EXPECT: 400
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Test User",
  "email": "bu-email-deyil",
  "password": "{{pwd}}",
  "confirmPassword": "{{pwd}}"
}

### 1.5  Müştəri 1 login
# EXPECT: 200; accessToken var
# @name login1
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email1}}",
  "password": "{{pwd}}"
}

### 1.6  Səhv şifrə
# EXPECT: 401
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email1}}",
  "password": "SehvSifre123"
}

### 1.7  Mövcud olmayan e-poçt
# EXPECT: 401; mesaj 1.6 ilə eynidir (e-poçtun varlığı açıqlanmır)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "yoxdur-{{run}}@test.az",
  "password": "SehvSifre123"
}

### 1.8  Admin login
# EXPECT: 200; roles içində "Admin"
# @name adminLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### 1.9  Öz profilim (müştəri)
# EXPECT: 200; fullName="Müştəri Bir", roles=["User"]
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{customerToken}}

### 1.10  Token olmadan profil
# EXPECT: 401; standart zərf (success=false)
GET {{baseUrl}}/api/users/me

### 1.11  Dəyişdirilmiş (saxta) token
# EXPECT: 401
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{adminToken}}x

### 1.12  Müştəri 2 qeydiyyatı (refresh testi üçün)
# EXPECT: 201
# @name reg2
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Müştəri İki",
  "email": "{{email2}}",
  "password": "{{pwd}}",
  "confirmPassword": "{{pwd}}"
}

### 1.13  Refresh token ilə yeni cüt
# EXPECT: 200; yeni refreshToken köhnədən fərqlidir
# @name refresh2
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{reg2.response.body.$.data.refreshToken}}"
}

### 1.14  KÖHNƏ refresh token yenidən (oğurluq simulyasiyası)
# EXPECT: 401
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{reg2.response.body.$.data.refreshToken}}"
}

### 1.15  Yeni refresh token da ləğv olunub
# EXPECT: 401 (reuse aşkarlandıqdan sonra istifadəçinin bütün token-ləri ləğv edilir)
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refresh2.response.body.$.data.refreshToken}}"
}

### 1.16  Müştəri 2 yenidən login
# EXPECT: 200
# @name login2
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email2}}",
  "password": "{{pwd}}"
}

### 1.17  Logout
# EXPECT: 204
POST {{baseUrl}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{login2.response.body.$.data.refreshToken}}"
}

### 1.18  Logout olmuş token ilə refresh
# EXPECT: 401
POST {{baseUrl}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{login2.response.body.$.data.refreshToken}}"
}

### 1.19  Müştəri 3 qeydiyyatı (bloklama testi üçün)
# EXPECT: 201
# @name reg3
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Müştəri Üç",
  "email": "{{email3}}",
  "password": "{{pwd}}",
  "confirmPassword": "{{pwd}}"
}

########################################################################
# 2. Şəhər və rayonlar (açıq)

### 2.1  Şəhərlər
# EXPECT: 200; "Bakü" var
# @name cities
GET {{baseUrl}}/api/cities

### 2.2  Şəhərin rayonları
# EXPECT: 200; 9 rayon (Bilgah, Hövsan, Maştağa, Merdakan, Nardaran, Pirşağı, Ramana, Sabuncu, Zabrat)
# @name districts
GET {{baseUrl}}/api/districts?cityId={{cityId}}

### 2.3  Bütün rayonlar
# EXPECT: 200; 9 rayon
GET {{baseUrl}}/api/districts

########################################################################
# 3. Elan yerləşdirmə qaydası (yalnız Admin)
# Bu hissə Moderation:AdminOnlyPosting=true (standart) rejimi üçündür.

### 3.1  Token olmadan elan yaratma
# EXPECT: 401
POST {{baseUrl}}/api/properties
Content-Type: application/json

{
  "title": "Token olmadan elan",
  "description": "Test elanı: bu mətn validasiya üçün kifayət qədər uzundur.",
  "address": "Bilgah, Bakü",
  "price": 150000,
  "area": 750,
  "propertyType": "Land",
  "zoning": "Residential",
  "terrain": "Flat",
  "roadAccess": "AsphaltFrontage",
  "utilities": [
    "Electricity",
    "Water"
  ],
  "cityId": {{cityId}},
  "districtId": {{districtId}}
}

### 3.2  MÜŞTƏRİ elan yaratmağa çalışır
# EXPECT: 403; "Only administrators can publish and manage listings."
POST {{baseUrl}}/api/properties
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "title": "Müştəri elanı cəhdi",
  "description": "Test elanı: bu mətn validasiya üçün kifayət qədər uzundur.",
  "address": "Bilgah, Bakü",
  "price": 150000,
  "area": 750,
  "propertyType": "Land",
  "zoning": "Residential",
  "terrain": "Flat",
  "roadAccess": "AsphaltFrontage",
  "utilities": [
    "Electricity",
    "Water"
  ],
  "cityId": {{cityId}},
  "districtId": {{districtId}}
}

### 3.3  ADMİN elan yaradır
# EXPECT: 201; status="Active" (təsdiq lazım deyil); slug var; zoning="Konut imarlı"; utilities=["Elektrik","Su"]
# @name createAd
POST {{baseUrl}}/api/properties
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Test elanı: Bilgah arsası",
  "description": "Test elanı: bu mətn validasiya üçün kifayət qədər uzundur.",
  "address": "Bilgah, Bakü",
  "price": 150000,
  "area": 750,
  "propertyType": "Land",
  "zoning": "Residential",
  "terrain": "Flat",
  "roadAccess": "AsphaltFrontage",
  "utilities": [
    "Electricity",
    "Water"
  ],
  "cityId": {{cityId}},
  "districtId": {{districtId}}
}

### 3.4  Admin yanlış məlumat göndərir (qiymət 0, sahə -1, qısa başlıq, təkrar kommunal, məsafəsiz yol)
# EXPECT: 400; errors siyahısı
POST {{baseUrl}}/api/properties
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "abc",
  "description": "Test elanı: bu mətn validasiya üçün kifayət qədər uzundur.",
  "address": "Bilgah, Bakü",
  "price": 0,
  "area": -1,
  "propertyType": "Land",
  "zoning": "Residential",
  "terrain": "Flat",
  "roadAccess": "MainRoadNearby",
  "utilities": [
    "Water",
    "Water"
  ],
  "cityId": {{cityId}},
  "districtId": {{districtId}}
}

### 3.5  Mövcud olmayan rayon
# EXPECT: 400 ("district does not exist")
POST {{baseUrl}}/api/properties
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Yanlış rayon elanı",
  "description": "Test elanı: bu mətn validasiya üçün kifayət qədər uzundur.",
  "address": "Bilgah, Bakü",
  "price": 150000,
  "area": 750,
  "propertyType": "Land",
  "zoning": "Residential",
  "terrain": "Flat",
  "roadAccess": "AsphaltFrontage",
  "utilities": [
    "Electricity",
    "Water"
  ],
  "cityId": {{cityId}},
  "districtId": 999999
}

########################################################################
# 4. Oxuma (açıq)

### 4.1  Elan siyahısı
# EXPECT: 200; totalCount = 10 (9 demo + yeni elan)
# @name list1
GET {{baseUrl}}/api/properties

### 4.2  Elan id ilə
# EXPECT: 200; zoning="Konut imarlı"; utilities=["Elektrik","Su"]; roadAccess="Asfalt yola cepheli"; ownerName var
# @name getAd
GET {{baseUrl}}/api/properties/{{adId}}

### 4.3  Elan slug ilə
# EXPECT: 200; 4.2 ilə eyni elan
GET {{baseUrl}}/api/properties/{{adSlug}}

### 4.4  Köhnə frontend linki (demo slug)
# EXPECT: 200; isDemo=true; verified=false; roadAccess="Asfalt yola cepheli"; image mütləq URL
# @name demoGet
GET {{baseUrl}}/api/properties/merdakan-konut-arsasi

### 4.5  Demo: yola məsafə
# EXPECT: 200; roadAccess="Ana yola 300 m"; roadDistanceMeters=300
GET {{baseUrl}}/api/properties/bilgah-yatirim-arsasi

### 4.6  Mövcud olmayan id
# EXPECT: 404; success=false
GET {{baseUrl}}/api/properties/999999

### 4.7  Mövcud olmayan slug
# EXPECT: 404
GET {{baseUrl}}/api/properties/bele-elan-yoxdur

### 4.8  Seçilmişlər
# EXPECT: 200; 3 elan (merdakan, bilgah, sabuncu), hamısı featured=true
GET {{baseUrl}}/api/properties/featured

########################################################################
# 5. Axtarış, filtr, sıralama, səhifələmə
# Gözlənilən saylar təzə bazaya və 3.3-dəki elana əsaslanır: qiymət 150000, sahə 750, Konut imarlı, Land, rayon = siyahıdakı ilk rayon (adətən Bilgah).

### 5.1  Rayon filtri
# EXPECT: 200; totalCount = 2 (rayondakı 1 demo + yeni elan; ilk rayon Bilgah deyilsə: 1 və ya 2)
GET {{baseUrl}}/api/properties?districtId={{districtId}}

### 5.2  Qiymət aralığı 100000–200000
# EXPECT: 200; totalCount = 6
GET {{baseUrl}}/api/properties?minPrice=100000&maxPrice=200000

### 5.3  Sahə aralığı 500–1000
# EXPECT: 200; totalCount = 5
GET {{baseUrl}}/api/properties?minArea=500&maxArea=1000

### 5.4  İmar: Agricultural
# EXPECT: 200; totalCount = 3 (hamısı "Tarım arazisi")
GET {{baseUrl}}/api/properties?zoning=Agricultural

### 5.5  İmar: Investment
# EXPECT: 200; totalCount = 3 ("Yatırımlık arsa")
GET {{baseUrl}}/api/properties?zoning=Investment

### 5.6  İmar: Residential
# EXPECT: 200; totalCount = 4
GET {{baseUrl}}/api/properties?zoning=Residential

### 5.7  Tip: Land
# EXPECT: 200; totalCount = 10
GET {{baseUrl}}/api/properties?propertyType=Land

### 5.8  Tip: Field
# EXPECT: 200; totalCount = 0
GET {{baseUrl}}/api/properties?propertyType=Field

### 5.9  Axtarış: Merdakan
# EXPECT: 200; totalCount = 1
GET {{baseUrl}}/api/properties?search=Merdakan

### 5.10  Axtarış: Bilgah (rayon adı)
# EXPECT: 200; totalCount = 2 (rayon Bilgah-dırsa)
GET {{baseUrl}}/api/properties?search=Bilgah

### 5.11  Qiymət artan
# EXPECT: 200; ilk elanın qiyməti 72000, sonuncunun 212500
GET {{baseUrl}}/api/properties?sortBy=price&sortOrder=asc

### 5.12  Qiymət azalan
# EXPECT: 200; ilk elanın qiyməti 212500
GET {{baseUrl}}/api/properties?sortBy=price&sortOrder=desc

### 5.13  Sahə azalan
# EXPECT: 200; ilk elanın sahəsi 3200
GET {{baseUrl}}/api/properties?sortBy=area&sortOrder=desc

### 5.14  Sahə artan
# EXPECT: 200; ilk elanın sahəsi 400
GET {{baseUrl}}/api/properties?sortBy=area&sortOrder=asc

### 5.15  Defolt sıralama (ən yeni)
# EXPECT: 200; ilk elan 3.3-də yaradılan elandır
GET {{baseUrl}}/api/properties

### 5.16  Səhifələmə: 2-ci səhifə, 3-lük
# EXPECT: 200; items=3 (qiymətlər 115000, 128000, 150000); totalCount=10; totalPages=4
GET {{baseUrl}}/api/properties?page=2&pageSize=3&sortBy=price&sortOrder=asc

### 5.17  Birgə filtrlər
# EXPECT: 200; totalCount = 3; qiymətlər azalan: 180000, 150000, 115000
GET {{baseUrl}}/api/properties?zoning=Residential&minPrice=100000&maxPrice=200000&minArea=500&sortBy=price&sortOrder=desc

### 5.18  featured=true filtri
# EXPECT: 200; totalCount = 3
GET {{baseUrl}}/api/properties?featured=true

### 5.19  pageSize=1000
# EXPECT: 400
GET {{baseUrl}}/api/properties?pageSize=1000

### 5.20  page=0
# EXPECT: 400
GET {{baseUrl}}/api/properties?page=0

### 5.21  minPrice > maxPrice
# EXPECT: 400
GET {{baseUrl}}/api/properties?minPrice=10&maxPrice=5

### 5.22  Yanlış enum (propertyType=Castle)
# EXPECT: 400; standart zərf
GET {{baseUrl}}/api/properties?propertyType=Castle

### 5.23  Yanlış sortBy
# EXPECT: 400
GET {{baseUrl}}/api/properties?sortBy=password

### 5.24  SQL injection cəhdi
# EXPECT: 200; totalCount = 0 (xəta yox, bütün elanlar qayıtmır)
GET {{baseUrl}}/api/properties?search=%27%20OR%201%3D1%20--

### 5.25  Axtarışda % simvolu (wildcard olmamalıdır)
# EXPECT: 200; totalCount = 0
GET {{baseUrl}}/api/properties?search=%25

### 5.26  Axtarışda _ simvolu (wildcard olmamalıdır)
# EXPECT: 200; totalCount = 0
GET {{baseUrl}}/api/properties?search=_

